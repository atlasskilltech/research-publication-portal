# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — real values never go in Git (only the placeholder template)
.env
.env.*
!.env.example

# database backups, dumps and migration exports (may contain personal data /
# password hashes). Legitimate schema files under docs/legacy-supabase stay tracked.
*.sql
*.sql.gz
*.dump
!docs/legacy-supabase/migrations/*.sql
/rpp-backups/
/backups/
supabase-export*/
*-export.json

# private manuscript storage (must live outside the repo; guard against mistakes)
/manuscripts/
/uploads/

# credentials
*.key
*.p12
credentials*.json

# typescript/next
next-env.d.ts

# editor
.vscode

# live end-to-end test manifests
.e2e-manifest-*.json
