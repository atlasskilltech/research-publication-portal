# Research Publication Portal — environment template
# Copy this file to .env.local and fill in REAL values there.
# .env.local is git-ignored; never commit real credentials.

# --- Database (MySQL, accessed directly via mysql2 — no Prisma) ---
# Two ways to configure, in order of precedence:
#
# 1) Discrete DB_* variables (RECOMMENDED for servers). When DB_USER, DB_PASS
#    and DB_NAME are all set, these are used and any DATABASE_URL is IGNORED —
#    so a stray DATABASE_URL in the shell/pm2/another env file can never
#    silently override these values.
# DB_HOST=127.0.0.1          # use 127.0.0.1 to force TCP; or a remote host/IP
# DB_PORT=3306
# DB_USER=atlasskilltechun_research_publication_portal
# DB_PASS=your-password-here
# DB_NAME=atlasskilltechun_research_publication_portal
# DB_SSL=true                # optional TLS; "accept_invalid_certs" for self-signed
#
# 2) DATABASE_URL (fallback, convenient for local dev). Used ONLY when the
#    DB_* parts above are not all set. Schema lives in db/schema.sql.
#    - If your password contains @ : / ? # or spaces, URL-encode them (@ -> %40)
#    - Optional TLS: append ?ssl=true (or ?sslaccept=accept_invalid_certs)
# DATABASE_URL="mysql://MYSQL_USER:MYSQL_PASSWORD@127.0.0.1:3306/atlasskilltechun_research_publication_portal"

# --- Sessions ---
# Custom server-side sessions are used (cryptographically random tokens, hashed
# in MySQL, httpOnly cookies). No signing secret / AUTH_SECRET is required.

# --- Account policy ---
# Comma-separated list of approved email domains for self-registration.
# Documented default (open-questions-and-assumptions.md B4): atlasuniversity.edu.in
ALLOWED_EMAIL_DOMAINS="atlasuniversity.edu.in"
