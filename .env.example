# ---------------------------------------------------------------------------
# Research Publication Portal — environment template
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must NEVER be committed. Moving to another MySQL server should
# require changing ONLY this file — no application code.
#
# Local development uses XAMPP MySQL; production uses the cPanel/EC2 MySQL
# database. Keep the two sets of credentials in separate .env.local files.
# ---------------------------------------------------------------------------

# ---- MySQL ----------------------------------------------------------------
# Local XAMPP example (the local database is named below):
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=root
#   DB_PASSWORD=            # XAMPP's root is blank by default; set yours if not
#   DB_NAME=atlasskilltechun_research_publication_portal
#
# Production uses the cPanel database name/user (often prefixed), the DB host
# cPanel/EC2 gives you, and a real password — set those only in production's
# own .env.local, never here.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atlasskilltechun_research_publication_portal

# Connection pool. Raise DB_CONNECTION_LIMIT on servers with more concurrency.
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000

# Set to `true` when the server requires TLS (some managed MySQL providers do).
DB_SSL=false
# Optional CA certificate CONTENTS for providers that need one. Blank = use the
# system trust store.
DB_SSL_CA=

# ---- Session --------------------------------------------------------------
# Server-side sessions store only a SHA-256 hash of a random token, so there is
# no signing secret to manage. These are optional and have working defaults.
# SESSION_COOKIE_NAME=rpp_session
# SESSION_TTL_DAYS=30

# ---- Registration ---------------------------------------------------------
# Comma-separated list of email domains allowed to self-register. Defaults to
# atlasuniversity.edu.in when unset.
# ALLOWED_EMAIL_DOMAINS=atlasuniversity.edu.in
