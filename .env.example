# ---------------------------------------------------------------------------
# Research Publication Portal — environment template (names + placeholders only)
#
# Local development: copy to `.env.local`.  Production (EC2): set these in the
# server's `.env`.  BOTH `.env.local` and `.env` are gitignored — never commit
# real values, and never print or log them.
# ---------------------------------------------------------------------------

# ── Supabase — REQUIRED by the application ─────────────────────────────────
# Public values (safe to expose; Row Level Security protects the data). They are
# read by the server at runtime AND, if ever referenced by client code, inlined
# at build time — so they must be present BOTH when `npm run build` runs and
# when the app runs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the deployed site — used for EVERY email/auth redirect
# (the invite/verification link). In production it MUST be the real domain so
# links never point at localhost. Locally, omit it (defaults to the dev origin)
# or set it to your local URL.
NEXT_PUBLIC_SITE_URL=https://research.atlasskilltech.app

# ── Student Application Number verification — SERVER-ONLY ───────────────────
# Secret key for the university student-check API, sent only in the server→server
# request header. Never prefix with NEXT_PUBLIC_, never commit, never log.
STUDENT_CHECK_API_KEY=xxxxxxxxxxxxxxxx
# Optional override of the endpoint (defaults to the UAT dashboard).
# STUDENT_CHECK_API_URL=https://uat-dashboard.atlasskilltech.app/api/app/student-check/exists

# ── Supabase service-role key — SERVER-ONLY, admin tooling ─────────────────
# Bypasses RLS. Used ONLY by the admin/provisioning scripts (supabase:*), NOT by
# the running app — so it is required in an environment only if you run those
# scripts there. Never prefix with NEXT_PUBLIC_, never commit, never log.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ── Local tooling ONLY — do NOT set in production ──────────────────────────
# Supabase Personal Access Token for running migrations via the Management API
# (npm run supabase:migrate / supabase:verify). Developer machines only.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxx
# Gmail sender used only by local email-test tooling. Real outbound email is
# configured as Custom SMTP in the Supabase dashboard — the app never reads these.
EMAIL_ID=you@example.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── Optional app setting (has a working default) ───────────────────────────
# Comma-separated domains allowed to self-register. Defaults to
# atlasuniversity.edu.in when unset.
# ALLOWED_EMAIL_DOMAINS=atlasuniversity.edu.in

# Exact-email exceptions allowed to self-register IN ADDITION to the domain(s)
# above (does NOT open a whole domain). When UNSET, defaults to the single
# testing address sf48116@gmail.com. To DISABLE all exceptions after testing,
# set it to an empty value: ALLOWED_EMAILS=
# ALLOWED_EMAILS=sf48116@gmail.com

# Original admin accounts that must never be demoted or deleted via the admin
# UI/API. Defaults to the two founding admins when unset.
# PROTECTED_ADMIN_EMAILS=faizan.shaikh@atlasuniversity.edu.in,elizabeth.jerome@atlasuniversity.edu.in
