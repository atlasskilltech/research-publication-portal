# ---------------------------------------------------------------------------
# Research Publication Portal — environment template (names + placeholders only)
#
# Local development: copy to `.env.local`.  Production (Ubuntu/EC2): set these
# in the server's `.env`.  BOTH `.env.local` and `.env` are gitignored — never
# commit real values, and never print or log them.
# The application needs NO Supabase (or any other hosted backend) configuration.
# ---------------------------------------------------------------------------

PORT=5630

# ── MySQL — REQUIRED (server-only) ─────────────────────────────────────────
# The portal runs in the SHARED cPanel database (also used by the Employment
# Survey). It only ever creates/reads/writes its own tables, all prefixed
# `research_` (see lib/db/tables.mjs); every other table is left untouched.
# Same variable names as Atlas Forge. Never commit or print the password.
DB_HOST=65.1.118.10
DB_PORT=3306
DB_USER=atlasuniversitye_employment_user
DB_PASSWORD=
DB_NAME=atlasuniversitye_employment_survey
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
# Optional TLS to the database server (DB_SSL_CA = PEM text or a path to a PEM file).
# DB_SSL=true
# DB_SSL_CA=/etc/ssl/certs/db-ca.pem
# (DB_PASS and DB_POOL_SIZE are still accepted as legacy aliases.)

# Public base URL of the deployed site — used for EVERY emailed auth link and the
# CSRF same-origin check. In production it MUST be the real https domain.
NEXT_PUBLIC_SITE_URL=https://research.atlasskilltech.app

# ── Sessions (optional; server-side in MySQL) ──────────────────────────────
# Absolute lifetime and idle timeout of a signed-in session, in hours.
# SESSION_TTL_HOURS=168
# SESSION_IDLE_HOURS=72

# ── Google Sign-In — SERVER-ONLY (optional feature) ─────────────────────────
# Direct OpenID Connect with Google (no third-party auth service). Only
# @atlasuniversity.edu.in accounts that ALREADY have a portal account can sign
# in. Leave unset to hide/disable Google sign-in (button shows "unavailable").
# GOOGLE_REDIRECT_URI must be registered on the Google OAuth client exactly.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://research.atlasskilltech.app/auth/callback

# ── Manuscript file storage — SERVER-ONLY (private, persistent) ────────────
# Absolute path to a PRIVATE directory where uploaded manuscripts are stored.
# MUST be outside the application/deploy directory and NOT under public/ or Git.
# Required in production; locally it defaults to a temp dir if unset.
MANUSCRIPT_STORAGE_DIR=/srv/rpp/manuscripts

# ── Student Application Number verification — SERVER-ONLY ───────────────────
STUDENT_CHECK_API_KEY=xxxxxxxxxxxxxxxx
# STUDENT_CHECK_API_URL=https://uat-dashboard.atlasskilltech.app/api/app/student-check/exists

# ── Transactional email — SERVER-ONLY (Gmail / Google Workspace SMTP) ──────
# All account emails (registration, password setup/reset/changed) and workflow
# notifications are sent by the portal itself over SMTP as EMAIL_ID, using a
# Google App Password. Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT
# (465). Test a real send: npm run test:email-live
EMAIL_ID=you@example.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM_NAME=Research Publication Portal
EMAIL_REPLY_TO=

# ── Optional app settings (working defaults) ───────────────────────────────
# ALLOWED_EMAIL_DOMAINS=atlasuniversity.edu.in
# Exact-email exceptions allowed to self-register (unset → sf48116@gmail.com;
# set empty to disable all exceptions): ALLOWED_EMAILS=
# PROTECTED_ADMIN_EMAILS=faizan.shaikh@atlasuniversity.edu.in,elizabeth.jerome@atlasuniversity.edu.in
