# Research Publication Portal — environment template
# Copy this file to .env.local and fill in REAL values there.
# .env.local is git-ignored; never commit real credentials.

# --- Database (local MySQL via Prisma) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# - HOST  : use 127.0.0.1 to force TCP (MySQL is confirmed listening on 3306)
# - If your password contains @ : / ? # or spaces, URL-encode them (e.g. @ -> %40)
DATABASE_URL="mysql://MYSQL_USER:MYSQL_PASSWORD@127.0.0.1:3306/atlasskilltechun_research_publication_portal"

# --- Auth.js (required at runtime for login/sessions) ---
# Generate with:  openssl rand -base64 32    (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
# Base URL of the app (local dev shown; set the real URL in each environment).
AUTH_URL="http://localhost:3000"

# --- Account policy ---
# Comma-separated list of approved email domains for self-registration.
# Documented default (open-questions-and-assumptions.md B4): atlasuniversity.edu.in
ALLOWED_EMAIL_DOMAINS="atlasuniversity.edu.in"
