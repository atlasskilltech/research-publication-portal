    "supabase:set-admin-password": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/set-admin-password.mjs",
    "supabase:test-auth": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-auth.mjs",
    "supabase:test-http": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/test-auth-http.mjs",
