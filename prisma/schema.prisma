// Research Publication Portal — Prisma schema
// Phase 1 (authentication / user tables only). The publication workflow
// (papers, per-paper roles, reviews, volumes, audit) is intentionally NOT here
// yet and will be added in a later, separately-approved phase.
//
// Portable by design: no MySQL-only features are used, so the same schema can
// initialize the production database later via `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Base registration category. Functional roles (SPOC, reviewers, editor) are
/// per-paper and belong to the later workflow phase — they are not stored here.
enum BaseType {
  STUDENT
  FACULTY
}

/// A portal account. Everyone signs in as a user; everyone starts as a
/// Submitter (base type STUDENT or FACULTY). `isAdmin` is the only global role.
model User {
  id            String    @id @default(cuid())
  name          String    @db.VarChar(191)
  email         String    @unique @db.VarChar(191) // case-insensitive via utf8mb4 default collation
  passwordHash  String    @db.VarChar(255)
  baseType      BaseType  @default(STUDENT)
  isAdmin       Boolean   @default(false)
  schoolCode    String?   @db.VarChar(16)  // ISDI | ISME | uGDX | LAW (FK to schools table added in workflow phase)
  rollNo        String?   @db.VarChar(64)  // students only
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]

  @@map("users")
}

/// Server-side session. The raw token lives only in the user's httpOnly cookie;
/// the database stores only its SHA-256 hash. No signing secret is required.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(191)
  userId    String   @db.VarChar(191)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// For email verification and password reset (standard Auth.js shape).
model VerificationToken {
  identifier String   @db.VarChar(191)
  token      String   @unique @db.VarChar(191)
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
